[user]
	signingkey = ~/.ssh/id_ed25519.pub
	name = James Goode
	email = james@everycopy.com

[gpg]
	format = ssh

[gpg "ssh"]
	allowedSignersFile = ~/Code/dotfiles/allowed_signers

[commit]
	gpgsign = true

[core]
	excludesfile = ~/Code/dotfiles/gitignore
	editor = zed --wait

[alias]
	amend = commit -a --amend
	cm = !git add -A && git commit -m
	co = checkout
	cob = checkout -b
	com = !git checkout main && git pull --rebase
	halp = !git fetch origin && git reset --hard origin
	pom = pull origin main
	prune = fetch --prune
	st = status -s
	sp = stash pop
	save = !git add -A && git commit -m "Save changes for later"
	up = !git pull --rebase --prune $@ && git submodule update --init --recursive
	undo = reset HEAD~1 --mixed
	recent = branch --sort=-committerdate --format=\"%(committerdate:relative)%09%(refname:short)\"

[push]
	default = simple

[pull]
	rebase = true

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
